{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contribution Party configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["theme", "points", "overInterval", "partyScore", "palettes"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "theme": {
      "enum": ["dark", "light", "auto"],
      "description": "Initial theme. Use auto to follow the system preference."
    },
    "ballCollisions": {
      "type": "boolean",
      "default": false,
      "description": "Enable elastic collisions between balls. Defaults to false."
    },
    "points": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [{ "const": 0 }],
      "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "description": "Points for activity levels 0 to 4. The first value must be 0."
    },
    "overInterval": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Score interval between OVER milestones."
    },
    "partyScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Score threshold for the automatic party. The score must exceed this value."
    },
    "superPartyScore": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991,
      "default": null,
      "description": "Score threshold for a one-time ten-ball SUPER PARTY. Must be at least partyScore. Triggers above this value. Use null or omit to disable."
    },
    "palettes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dark", "light"],
      "properties": {
        "dark": { "$ref": "#/$defs/palette" },
        "light": { "$ref": "#/$defs/palette" }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "foreground", "mutedForeground", "surface", "border", "ball", "grass", "celebration", "lights"],
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "foreground": { "$ref": "#/$defs/color" },
        "mutedForeground": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "ball": { "$ref": "#/$defs/color" },
        "grass": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/color" },
          "description": "Colors for activity levels 0 to 4."
        },
        "celebration": { "$ref": "#/$defs/color" },
        "lights": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/color" }
        }
      }
    }
  }
}
