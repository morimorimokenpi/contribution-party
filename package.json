{
  "name": "contribution-party",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "biome lint . --error-on-warnings --diagnostic-level=warn",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "generate": "node scripts/generate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "6.0.3"
  },
  "description": "Generate an animated contribution pinball SVG for GitHub READMEs.",
  "repository": {
    "type": "git",
    "url": "https://github.com/morimorimokenpi/contribution-party.git"
  },
  "engines": {
    "node": ">=24"
  }
}
